# FINN environment template. Copy to .env and fill in locally.
# NEVER commit real keys. .env is gitignored. Leave blank what you don't use.

# ---- Runtime ----
FINN_ENV=development                # development | production
FINN_DATA_MODE=live                 # live (default) | fixture (synthetic companies, no network; shows a fixture banner)
FINN_DB_PATH=                       # default ./data/finn.db (ephemeral cache; safe to delete)
FINN_CORS_ORIGINS=*                 # comma-separated origins allowed to call the API
FINN_TIMEZONE=Asia/Kolkata
FINN_HISTORY_YEARS=10               # years of daily prices backfilled in the background at start-up (fixture mode: 3)
LOG_LEVEL=INFO

# ---- Storage ----
DATABASE_URL=sqlite:///./data/finn.db   # EPHEMERAL on Render free: rebuilt at boot (ARCHITECTURE §4b). No hosted DB in MVP
CACHE_DIR=./data/cache                  # downloaded PDFs/XBRL (ephemeral), keyed by sha256
SEED_DIR=./data/seed                    # committed seed snapshot (bars/announcements) with as_of stamp
SEED_CACHE_DIR=./data/seed_cache        # committed derived LLM outputs for the 22 demo tickers
MAX_OUTBOUND_MB_PER_DAY=              # optional guard against Render's service-initiated-traffic suspension

# ---- LLM routing: FREE TIERS ONLY ----
# Two routes (fast, long) x two slots (primary, fallback). Each slot names BOTH provider and model.
# Model IDs are deliberately blank: fill them after Spike S6 lists the models your free keys can access.
# Providers: google | groq
GOOGLE_API_KEY=                     # Google AI Studio key (project with NO billing linked = free tier)
GROQ_API_KEY=                       # console.groq.com key (free plan, no card). Used first for write-ups
GROQ_MODEL=                         # optional; default openai/gpt-oss-120b
OPENROUTER_API_KEY=                 # openrouter.ai key (free ":free" models, 50 requests/day without credits). Backup
OPENROUTER_MODEL=                   # optional; default openrouter/free

LLM_FAST_PRIMARY_PROVIDER=groq
LLM_FAST_PRIMARY_MODEL=
LLM_FAST_FALLBACK_PROVIDER=google
LLM_FAST_FALLBACK_MODEL=

LLM_LONG_PRIMARY_PROVIDER=google
LLM_LONG_PRIMARY_MODEL=
LLM_LONG_FALLBACK_PROVIDER=groq     # runs in "reduced mode" (chunked inputs), see ARCHITECTURE §6.1
LLM_LONG_FALLBACK_MODEL=

# Optional self-imposed budgets per slot. Leave BLANK until you've read the real limits in each
# provider console (S6), then set ~80% of them. Blank = rely on provider 429/retry-after only.
LLM_FAST_PRIMARY_MAX_RPM=
LLM_FAST_PRIMARY_MAX_RPD=
LLM_FAST_FALLBACK_MAX_RPM=
LLM_FAST_FALLBACK_MAX_RPD=
LLM_LONG_PRIMARY_MAX_RPM=
LLM_LONG_PRIMARY_MAX_RPD=
LLM_LONG_FALLBACK_MAX_RPM=
LLM_LONG_FALLBACK_MAX_RPD=

LLM_PROMPT_VERSION=1                # bump to invalidate cached LLM outputs

# ---- Data sources ----
HTTP_USER_AGENT=FINN-research-prototype/0.1 (contact: set-your-email)
SOURCE_MIN_DELAY_SECONDS=1.0        # politeness delay between requests to the same host
ANNOUNCEMENT_POLL_MINUTES=15
PRICE_HISTORY_DAYS=120

# ---- Alert defaults (all user-overridable in Settings) ----
ALERT_PRICE_PCT=5.0
ALERT_VOLUME_MULTIPLE=2.0
ALERT_VOLUME_LOOKBACK_SESSIONS=20

# ---- Push-side people enrichment (on by default, user Q-8) ----
ENABLE_PEOPLE_ENRICHMENT=true
TAVILY_API_KEY=                     # app.tavily.com free plan (1,000 credits/month, no card): executive backgrounds
TAVILY_MONTHLY_CREDIT_BUDGET=      # optional self-imposed cap; the official free plan is 1,000 credits/month

# ---- Ops ----
KEEPALIVE_ENABLED=true              # GitHub Actions pings /health about every 10 min (Render free sleeps after 15)
INGEST_SHARED_SECRET=               # protects /jobs/* endpoints; set a long random value in Render + GitHub secrets

# ---- Frontend (anything NEXT_PUBLIC_* is visible in the browser: never put secrets here) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Deployment (python deploy_hf.py): Hugging Face write token. Never commit the real value.
HF_TOKEN=
